# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交
# 改完执行: docker compose up -d --force-recreate

# ── LLM（OpenAI 兼容接口）──
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash
LLM_BATCH_SIZE=8
LLM_TIMEOUT=60

# ── SMTP 邮件 ──
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=you@163.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_TO=who@163.com

# ── 用户画像（决定「什么值得推」）──
# 不填则回落到 config.py 里的示例画像；建议把自己的方向写这里
USER_PROFILE="你的画像：技术方向 / 只接远程还是可到岗 / 明确不接的类型 / 报酬要求"
